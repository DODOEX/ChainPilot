# ── Compile-time defaults ────────────────────────────────────────────────────
# These two keys are read by build.rs at `cargo build` time and baked into the
# binary via option_env!(). They can still be overridden at runtime by setting
# the same env var or passing the corresponding CLI flag.
#
DODO_API_KEY=
DODO_PROJECT_ID=

# ── Runtime configuration ─────────────────────────────────────────────────────

# Target chain ID (default: 1 = Ethereum mainnet)
# CHAIN_ID=1

# RPC endpoint for the target chain.
# Defaults to the first URL in the built-in chain config for CHAIN_ID.
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# DODO route API endpoint (rarely needs changing)
# DODO_API_URL=https://api.dodoex.io/route-service/v2/widget/getdodoroute

# HTTP request timeout in seconds (default: 30)
# REQUEST_TIMEOUT_SECS=30

# How long a saved quote remains valid in seconds (default: 300)
# QUOTE_TTL_SECS=300

# Directory for persisted data: quotes, history, tokenlist cache (default: platform data dir)
# CHAIN_DATA_DIR=~/.local/share/chain

# ── Wallet ────────────────────────────────────────────────────────────────────
# Private key used for signing transactions.
# Can also be passed per-command with --wallet / -w.
# PRIVATE_KEY=0x...

# ── Logging ───────────────────────────────────────────────────────────────────
# RUST_LOG=chain=debug
