#!/usr/bin/env bash
set -euo pipefail

REPO="DODOEX/ChainPilot"
BIN_NAME="chainpilot"
INSTALL_DIR="${HOME}/.chainpilot/bin"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
err() { echo "error: $*" >&2; exit 1; }

need_cmd() {
  command -v "$1" &>/dev/null || err "required command not found: $1"
}

download() {
  local url="$1" dest="$2"
  if command -v curl &>/dev/null; then
    curl -fsSL "$url" -o "$dest"
  elif command -v wget &>/dev/null; then
    wget -qO "$dest" "$url"
  else
    err "neither curl nor wget is available"
  fi
}

fetch_text() {
  local url="$1"
  if command -v curl &>/dev/null; then
    curl -fsSL "$url"
  elif command -v wget &>/dev/null; then
    wget -qO- "$url"
  else
    err "neither curl nor wget is available"
  fi
}

# ---------------------------------------------------------------------------
# Platform detection
# ---------------------------------------------------------------------------
detect_platform() {
  local os arch

  os="$(uname -s)"
  case "$os" in
    Linux)  os="linux"  ;;
    Darwin) os="macos"  ;;
    *)      err "unsupported OS: $os" ;;
  esac

  arch="$(uname -m)"
  case "$arch" in
    x86_64)        arch="x86_64"  ;;
    arm64|aarch64) arch="aarch64" ;;
    *)             err "unsupported architecture: $arch" ;;
  esac

  echo "${os}-${arch}"
}

# ---------------------------------------------------------------------------
# Latest release version
# ---------------------------------------------------------------------------
latest_version() {
  local json
  json="$(fetch_text "https://api.github.com/repos/${REPO}/releases/latest")"
  # Extract tag_name without jq dependency
  echo "$json" | grep '"tag_name"' | sed -E 's/.*"tag_name": *"([^"]+)".*/\1/'
}

# ---------------------------------------------------------------------------
# Shell config helpers
# ---------------------------------------------------------------------------
append_path_to_file() {
  local file="$1"
  # Idempotent: skip if the line is already there
  if grep -q "\.chainpilot" "$file" 2>/dev/null; then
    return
  fi
  {
    echo ""
    echo "# ChainPilot"
    echo "export PATH=\"\$HOME/.chainpilot/bin:\$PATH\""
  } >> "$file"
}

setup_shell_path() {
  local shell_name
  shell_name="$(basename "${SHELL:-}")"

  case "$shell_name" in
    zsh)
      append_path_to_file "${ZDOTDIR:-$HOME}/.zshrc"
      echo "  -> added to ${ZDOTDIR:-$HOME}/.zshrc"
      ;;
    bash)
      append_path_to_file "$HOME/.bashrc"
      echo "  -> added to $HOME/.bashrc"
      if [[ "$(uname -s)" == "Darwin" ]]; then
        append_path_to_file "$HOME/.bash_profile"
        echo "  -> added to $HOME/.bash_profile"
      fi
      ;;
    fish)
      local fish_config="${XDG_CONFIG_HOME:-$HOME/.config}/fish/config.fish"
      mkdir -p "$(dirname "$fish_config")"
      if ! grep -q "\.chainpilot" "$fish_config" 2>/dev/null; then
        {
          echo ""
          echo "# ChainPilot"
          echo "fish_add_path \$HOME/.chainpilot/bin"
        } >> "$fish_config"
        echo "  -> added to $fish_config"
      fi
      ;;
    *)
      echo ""
      echo "Unknown shell '$shell_name'. Add this to your shell config manually:"
      echo "  export PATH=\"\$HOME/.chainpilot/bin:\$PATH\""
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main() {
  local platform version asset_name archive_name download_url tmp_dir

  platform="$(detect_platform)"
  asset_name="${BIN_NAME}-${platform}"
  archive_name="${asset_name}.tar.gz"

  echo "Fetching latest ${BIN_NAME} release..."
  version="$(latest_version)"
  [[ -n "$version" ]] || err "could not determine latest version"

  echo "Installing ${BIN_NAME} ${version} (${platform})..."

  download_url="https://github.com/${REPO}/releases/download/${version}/${archive_name}"

  tmp_dir="$(mktemp -d)"
  trap 'rm -rf "$tmp_dir"' EXIT

  download "$download_url" "$tmp_dir/$archive_name"
  tar -xzf "$tmp_dir/$archive_name" -C "$tmp_dir"

  mkdir -p "$INSTALL_DIR"
  cp "$tmp_dir/$asset_name/$BIN_NAME" "$INSTALL_DIR/$BIN_NAME"
  chmod +x "$INSTALL_DIR/$BIN_NAME"

  echo "${BIN_NAME} installed to ${INSTALL_DIR}/${BIN_NAME}"
  echo ""

  # PATH setup
  if [[ ":${PATH}:" != *":${INSTALL_DIR}:"* ]]; then
    echo "Adding ${INSTALL_DIR} to PATH..."
    setup_shell_path
    echo ""
    echo "Open a new terminal, or run:"
    echo "  source ~/.zshrc   # (or your shell's config)"
    echo ""
  fi

  echo "Done! Verify with: ${BIN_NAME} --version"
}

main "$@"
